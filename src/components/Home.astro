<script>
  import { initMotion } from '../scripts/motion'
  import { initSmoothScroll } from '../scripts/smooth-scroll'
  initMotion()
  initSmoothScroll()

  // Theme switch: cycles system, light, dark. "System" follows the OS and stores nothing.
  const toggle = document.querySelector<HTMLButtonElement>('.theme-toggle')
  if (toggle) {
    const root = document.documentElement
    const order = ['system', 'light', 'dark']
    const label = () => {
      const mode = root.dataset.theme || 'system'
      const text = toggle.dataset['l' + mode[0].toUpperCase() + mode.slice(1)] || ''
      toggle.setAttribute('aria-label', text)
      toggle.title = text
    }
    label()
    toggle.addEventListener('click', () => {
      const next = order[(order.indexOf(root.dataset.theme || 'system') + 1) % order.length]
      if (next === 'system') delete root.dataset.theme
      else root.dataset.theme = next
      try {
        if (next === 'system') localStorage.removeItem('theme')
        else localStorage.setItem('theme', next)
      } catch (e) {}
      label()
    })
  }

  // Gifted Chat chart: draw the line once when it scrolls into view.
  const chartLine = document.querySelector('.chart-line')
  if (chartLine && 'IntersectionObserver' in window && !window.matchMedia('(prefers-reduced-motion: reduce)').matches) {
    const box = chartLine.closest('svg')?.getBoundingClientRect()
    if (box && box.top > window.innerHeight) {
      chartLine.classList.add('will-draw')
      const io = new IntersectionObserver((entries) => {
        if (!entries.some((e) => e.isIntersecting)) return
        io.disconnect()
        requestAnimationFrame(() => chartLine.classList.add('drawn'))
      }, { threshold: 0.4 })
      io.observe(chartLine.closest('svg') || chartLine)
    }
  }

  // Close the language menu on outside click or Escape.
  const menu = document.querySelector('.lang-menu')
  if (menu) {
    document.addEventListener('click', (e) => { if (menu.open && !menu.contains(e.target)) menu.open = false })
    document.addEventListener('keydown', (e) => { if (e.key === 'Escape' && menu.open) { menu.open = false; menu.querySelector('summary')?.focus() } })
  }
</script>

