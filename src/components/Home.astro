const P = stats.packages
const fmt = (n?: number) => (typeof n === 'number' ? compact(n, lang) : '-')
const ru = lang === 'ru'

const npmTotal = fmt(stats.totals.allTime)
const npmMonth = fmt(stats.totals.lastMonth)
const appsTotal = ru ? '250 тыс.+' : '250K+'
const fill = (s: string) => s.replace('{npm}', npmTotal).replace('{month}', npmMonth).replace('{apps}', appsTotal)
const replies = t.chat.replies.map((r) => ({ ...r, answer: fill(r.answer) }))
const showLabel = ru ? 'Показать' : 'Show me'

// Gifted Chat chart in the album's single line weight.
const series = (P['gifted-chat'].series ?? []) as [string, number][]
const W = 760, H = 250, PAD = 6
const max = Math.max(...series.map(([, v]) => v)) * 1.12
const x = (i: number) => PAD + (i / Math.max(series.length - 1, 1)) * (W - PAD * 2)
const y = (v: number) => H - (v / max) * (H - PAD)
const line = series.map(([, v], i) => `${i ? 'L' : 'M'}${x(i).toFixed(1)},${y(v).toFixed(1)}`).join(' ')
const area = `${line} L${x(series.length - 1).toFixed(1)},${H} L${x(0).toFixed(1)},${H} Z`
const startIdx = series.findIndex(([m]) => m === '2024-08')
// June 2026: last feature release of Gifted Chat, development moved to @kesha-antonov/react-native-chat.
const forkIdx = series.findIndex(([m]) => m === '2026-06')
const peak = series.reduce((b, s, i) => (s[1] > series[b][1] ? i : b), 0)
const years = series.map(([m], i) => [m, i] as const).filter(([m]) => m.endsWith('-01'))

const stepMarks = ['08.2024', '26', '3', fmt(series[peak]?.[1])]
