    : [['1', 'course catalog'], ['4', 'course page'], ['5', 'course plan'], ['3', 'lecture player'], ['2', 'library'], ['6', 'knowledge check']]),
  cryptoc: shot(`cryptoc-${ru ? 'ru' : 'en'}`, 'CryptoC', ru
    ? [['1', 'портфель'], ['2', 'виджеты'], ['3', 'уведомления о цене'], ['4', 'тёмная тема'], ['6', 'конвертер'], ['5', 'курсы валют']]
    : [['1', 'portfolio'], ['2', 'widgets'], ['3', 'price alerts'], ['4', 'dark theme'], ['6', 'converter'], ['5', 'exchange rates']]),
  sportsoul: shot('sportsoul', 'SportSoul', ru
    ? [['1', 'расписание тренировок'], ['2', 'поиск партнёра или тренера'], ['3', 'статистика тренировок'], ['4', 'фото и видео тренировок']]
    : [['1', 'workout schedule'], ['2', 'finding a partner or coach'], ['3', 'workout stats'], ['4', 'workout photos and videos']]),
  stickers: [
    { src: '/products/stickers-1.webp', alt: ru ? 'Falling in Fall: все стикеры' : 'Falling in Fall: the sticker set' },
    { src: '/products/stickers-2.webp', alt: ru ? 'Sports Sticker Pack: стикеры в чате' : 'Sports Sticker Pack in a chat' },
    { src: '/products/stickers-3.webp', alt: ru ? 'Falling in Fall: доброе утро' : 'Falling in Fall: good morning' },
    { src: '/products/stickers-4.webp', alt: ru ? 'Falling in Fall: выздоравливай' : 'Falling in Fall: get well soon' },
    { src: '/products/stickers-5.webp', alt: ru ? 'Falling in Fall: выбор стикера' : 'Falling in Fall: sticker picker' },
    { src: '/products/stickers-6.webp', alt: ru ? 'Sports Sticker Pack: все стикеры' : 'Sports Sticker Pack: the sticker set' },
  ],
}

---
<header class="page">
  <div class="masthead panel">
    <a class="mark" href={ru ? '/ru/' : '/'} aria-label="Kesha Antonov">
      <img class="avatar" src="/avatar.webp" alt="" width="44" height="44" />
      <span>Kesha Antonov</span>
    </a>
    <nav aria-label="Main">
      <a href="#work">{t.nav.work}</a>
      <a href="#products">{t.nav.products}</a>
      <a href="#oss">{t.nav.oss}</a>
      <button type="button" class="theme-toggle" aria-label={ru ? 'Тема: как в системе' : 'Theme: system'} title={ru ? 'Тема: как в системе' : 'Theme: system'} data-l-system={ru ? 'Тема: как в системе' : 'Theme: system'} data-l-light={ru ? 'Тема: светлая' : 'Theme: light'} data-l-dark={ru ? 'Тема: тёмная' : 'Theme: dark'}>
        <svg class="icon-auto" viewBox="0 0 24 24" width="22" height="22" aria-hidden="true"><rect x="2.5" y="4" width="19" height="13" rx="2" fill="var(--white)" stroke="var(--ink)" stroke-width="2.2" stroke-linejoin="round" /><path d="M12 5.2a5 5 0 0 1 0 10z" fill="var(--sand)" /><path d="M8 21h8M12 17v4" stroke="var(--ink)" stroke-width="2.2" stroke-linecap="round" /></svg>
        <svg class="icon-sun" viewBox="0 0 24 24" width="22" height="22" aria-hidden="true"><circle cx="12" cy="12" r="4.5" fill="var(--sand)" stroke="var(--ink)" stroke-width="2.2" /><path d="M12 2.5v2.5M12 19v2.5M2.5 12H5M19 12h2.5M5.3 5.3l1.8 1.8M16.9 16.9l1.8 1.8M5.3 18.7l1.8-1.8M16.9 7.1l1.8-1.8" stroke="var(--ink)" stroke-width="2.2" stroke-linecap="round" /></svg>
        <svg class="icon-moon" viewBox="0 0 24 24" width="22" height="22" aria-hidden="true"><path d="M20 14.5A8.5 8.5 0 0 1 9.5 4a8.5 8.5 0 1 0 10.5 10.5z" fill="var(--sand)" stroke="var(--ink)" stroke-width="2.2" stroke-linejoin="round" /></svg>
      </button>
      <details class="lang-menu">
        <summary aria-label={ru ? 'Язык' : 'Language'}>
          <svg viewBox="0 0 24 24" width="22" height="22" aria-hidden="true" class="globe">
            <circle cx="12" cy="12" r="9.5" fill="var(--white)" stroke="var(--ink)" stroke-width="2.2" />
            <path d="M2.5 12h19M12 2.5c-3 3-4.2 6-4.2 9.5s1.2 6.5 4.2 9.5M12 2.5c3 3 4.2 6 4.2 9.5s-1.2 6.5-4.2 9.5" fill="none" stroke="var(--ink)" stroke-width="2.2" stroke-linecap="round" />
          </svg>
          <span>{ru ? 'RU' : 'EN'}</span>
          <svg viewBox="0 0 12 8" width="12" height="8" aria-hidden="true" class="caret"><path d="M1.5 1.5L6 6l4.5-4.5" fill="none" stroke="var(--ink)" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" /></svg>
        </summary>
        <ul>
          <li><a href="/" hreflang="en" lang="en" aria-current={ru ? undefined : 'true'}>English</a></li>
          <li><a href="/ru/" hreflang="ru" lang="ru" aria-current={ru ? 'true' : undefined}>Русский</a></li>
        </ul>
      </details>
      <a class="btn red" href="#contact">{t.hero.ctaHire}</a>
    </nav>
  </div>
</header>

<main class="page">
  <section class="tier hero" aria-label={t.hero.title}>
    <div class="panel sky establishing">
      <span class="caption">{t.hero.kicker}</span>
      <h1><span class="visually-hidden">{t.hero.name}: </span>{t.hero.title}</h1>
      <p class="hero-sub">{t.hero.sub}</p>
      <div class="actions">
        <a class="btn red" href="#contact">{t.hero.ctaHire}</a>
        <a class="btn" href="#gifted">{t.hero.ctaWork}</a>
      </div>
    </div>

    <div class="panel paper phone-panel">
      <HeroChat client:visible title={t.chat.title} online={t.chat.online} intro={t.chat.intro} replies={replies} placeholder={t.chat.placeholder} showLabel={showLabel} />
    </div>

    <div class="scores" aria-label={L.score} role="group">
      <a class="panel red score big" href="#oss"><span class="num">{npmTotal}</span><span class="score-label"><svg class="score-icon" viewBox="0 0 64 64" width="30" height="30" aria-hidden="true" set:html={SCORE_ICONS[0]} />{L.npm}</span><small>{npmMonth} {L.month}</small></a>
      <a class="panel sand score" href="#work"><span class="num">{appsTotal}</span><span class="score-label"><svg class="score-icon" viewBox="0 0 64 64" width="30" height="30" aria-hidden="true" set:html={SCORE_ICONS[1]} />{L.apps}</span></a>
      <a class="panel sea score" href="#gifted"><span class="num">{fmt(P['gifted-chat'].sinceMaintenance)}</span><span class="score-label"><svg class="score-icon" viewBox="0 0 64 64" width="30" height="30" aria-hidden="true" set:html={SCORE_ICONS[2]} />{L.gifted}</span></a>
      <a class="panel harbour score" href="#contests"><span class="num">{CONTEST_WINS}</span><span class="score-label"><svg class="score-icon" viewBox="0 0 64 64" width="30" height="30" aria-hidden="true" set:html={SCORE_ICONS[3]} />{L.wins}</span></a>
    </div>
  </section>

  <section class="tier merged" aria-label={t.proof.merged}>
    <div class="panel paper strip">
      <span class="strip-title">{t.proof.merged}</span>
      <ul>{upstream.map((u) => <li><a target="_blank" rel="noopener" href={`https://github.com/${u.repo}/commits?author=kesha-antonov`}>{u.logo && <span class="logo-mono" style={`--logo: url(/logos/${u.logo}.svg)`} aria-hidden="true"></span>}{u.label}</a></li>)}</ul>
      <p class="handwritten">{t.proof.handwritten}</p>
    </div>
  </section>

  <section id="gifted" class="chapter">
    <h2>{t.gifted.title}</h2>
    <div class="tier narration">
      <div class="panel sand"><p>{t.gifted.problem}</p></div>
    </div>
    <ol class="tier four">
      {t.gifted.steps.map((s, i) => (
        <li class={`panel ${['white', 'sky', 'white', 'sea'][i]}`}>
          <span class="caption">{s.h}</span>
          <div class="step-head"><svg class="step-icon" viewBox="0 0 64 64" width="48" height="48" aria-hidden="true" set:html={STEP_ICONS[i]} /><span class="num step-mark">{stepMarks[i]}</span></div>
          <p>{s.p.split('react-native-chat').map((part, j) => (
            <>{j > 0 && <a target="_blank" rel="noopener" class="inline-link" href="https://github.com/kesha-antonov/react-native-chat">react-native-chat</a>}{part}</>
          ))}</p>
        </li>
      ))}
    </ol>
    <div class="tier">
      <figure class="panel chart-panel">
        <span class="caption">{t.gifted.chartTitle}</span>
        <svg viewBox={`0 0 ${W} ${H + 36}`} role="img" aria-label={t.gifted.chartTitle}>
          <path d={area} fill="var(--sky)" />
          <path class="chart-line" d={line} pathLength="1" fill="none" stroke="var(--ink)" stroke-width="3" stroke-linejoin="round" stroke-linecap="round" />
          <line x1="0" x2={W} y1={H} y2={H} stroke="var(--ink)" stroke-width="3" />
          {startIdx >= 0 && (
            <g>
              <line x1={x(startIdx)} x2={x(startIdx)} y1="14" y2={H} stroke="var(--mark-red)" stroke-width="3" stroke-dasharray="8 7" />
              <text x={x(startIdx) - 10} y="30" text-anchor="end" class="chart-label red">{t.gifted.chartNote}</text>
            </g>
          )}
          {forkIdx >= 0 && (
            <g>
              <line x1={x(forkIdx)} x2={x(forkIdx)} y1="14" y2={H} stroke="var(--mark-blue)" stroke-width="3" stroke-dasharray="8 7" />
              <text x={x(forkIdx) - 10} y={H - 18} text-anchor="end" class="chart-label harbour">{t.gifted.chartFork}</text>
            </g>
          )}
          <circle cx={x(peak)} cy={y(series[peak][1])} r="8" fill="var(--red)" stroke="var(--ink)" stroke-width="3" />
          <text x={x(peak) - 16} y={y(series[peak][1]) + 6} text-anchor="end" class="chart-label">{fmt(series[peak][1])}</text>
          {years.map(([m, i]) => <text x={x(i)} y={H + 30} text-anchor={i === 0 ? 'start' : 'middle'} class="chart-label">{m.slice(0, 4)}</text>)}
        </svg>
        <div class="chart-foot">
          <div><span class="num">{fmt(P['gifted-chat'].sinceMaintenance)}</span> {t.gifted.statSince}</div>
          <div><span class="num">{fmt(P['gifted-chat'].stars)}</span> {t.gifted.statStars}</div>
        </div>
      </figure>
    </div>
    <div class="tier">
      <article class="panel sky successor">
        <div class="successor-text">
          <h3>{t.gifted.successor.title}</h3>
          <p class="body">{t.gifted.successor.body}</p>
          <ul class="feature-chips">
            {t.gifted.successor.features.map((f) => <li>{f}</li>)}
          </ul>
          <p class="links">
            <a target="_blank" rel="noopener" href="https://github.com/kesha-antonov/react-native-chat">{t.gifted.successor.links.repo}</a>
            <a target="_blank" rel="noopener" href="https://kesha-antonov.com/react-native-chat/">{t.gifted.successor.links.docs}</a>
            <a target="_blank" rel="noopener" href="https://www.npmjs.com/package/@kesha-antonov/react-native-chat">npm</a>
          </p>
        </div>
        <div class="successor-demo">
          <video src="/products/rnc-showcase.mp4" poster="/products/rnc-poster.webp" width="360" height="808" autoplay muted loop playsinline preload="metadata" aria-label="react-native-chat demo"></video>
        </div>
      </article>
    </div>
    {rv && (
      <div class="tier">
        <article class="panel white revival">
          <div class="revival-text">
            <h3>{t.oss.revival.title(Math.round(rv.mine / rv.original))}</h3>
            <p>{t.oss.revival.lead}</p>
            <p class="revival-added">{t.oss.revival.added}</p>
            <p class="links">
              <a target="_blank" rel="noopener" href="https://github.com/kesha-antonov/react-native-background-downloader">{t.oss.revival.repo}</a>
              <a target="_blank" rel="noopener" href="https://kesha-antonov.github.io/react-native-background-downloader/">{t.oss.revival.docs}</a>
            </p>
          </div>
          <div class="revival-data">
            <p class="caption">{t.oss.revival.compare(rv.year)}</p>
            <div class="bars">
              <div class="bar-row">
                <span class="bar-label">{t.oss.revival.original}</span>
                <span class="bar"><span class="fill old" style={`width: ${Math.max(1.5, (rv.original / rv.mine) * 100).toFixed(1)}%`} /></span>
                <span class="num">{fmt(rv.original)}</span>
              </div>
              <div class="bar-row">
                <span class="bar-label">{t.oss.revival.mine}</span>
                <span class="bar"><span class="fill mine" style="width: 100%" /></span>
                <span class="num">{fmt(rv.mine)}</span>
              </div>
            </div>
            <ul class="facts three">
              <li class="red"><span class="num">{fmt(P['background-downloader'].allTime)}</span>{t.oss.revival.facts.total}</li>
              <li class="sand"><span class="num">{rv.releases}</span>{t.oss.revival.facts.releases}</li>
              <li class="sky"><span class="num">430+</span>{t.oss.revival.facts.commits}</li>
            </ul>
          </div>
        </article>
      </div>
    )}
  </section>

  <section id="work" class="chapter">
    <h2>{t.work.title}</h2>
    <div class="tier work">
      <article class="panel magisteria">
        <Shots items={SHOTS.magisteria} width={400} height={870} label={ru ? 'Экраны приложения Магистерия' : 'Magisteria app screens'} ru={ru} />
        <div class="app-head">
          <img src="/icons/magisteria.png" alt="" width="88" height="88" class="icon" />
          <div>
            <h3>{t.work.magisteria.name}</h3>
            <p class="tag">{t.work.magisteria.tag}</p>
          </div>
        </div>
        <p class="body">{t.work.magisteria.body}</p>
        <ul class="facts">
          {t.work.magisteria.stats.map(([n, l], i) => <li class={['sky', 'sea', 'sand', 'paper'][i]}><span class="num">{n}</span>{l}</li>)}
        </ul>
        <ul class="highlights">
          {t.work.magisteria.highlights.map((x, i) => (
            <li><div class="hl-head"><svg class="hl-icon" viewBox="0 0 64 64" width="36" height="36" aria-hidden="true" set:html={MAGISTERIA_ICONS[i]} /><span class="caption">{x.h}</span></div><p>{x.p}</p></li>
          ))}
        </ul>
        <p class="links">
          <a target="_blank" rel="noopener" href={apps.magisteria.appStore}><span class="logo-mono" style="--logo: url(/logos/app-store.svg)" aria-hidden="true"></span>App Store</a>
          <a target="_blank" rel="noopener" href={apps.magisteria.googlePlay}><span class="logo-mono" style="--logo: url(/logos/google-play.svg)" aria-hidden="true"></span>Google Play</a>
          <a target="_blank" rel="noopener" href={apps.magisteria.ruStore}><img class="logo-color" src="/logos/rustore.svg" alt="" width="18" height="18" />RuStore</a>
        </p>
        <p class="footnote">{t.work.magisteria.note}</p>
      </article>
      <article class="panel sea wide medical">
        <div class="app-head">
          <svg class="brand-stack" viewBox="0 0 120 96" width="110" height="88" aria-hidden="true">
            <rect x="40" y="4" width="64" height="64" rx="15" fill="var(--sky)" stroke="var(--ink)" stroke-width="3" />
            <rect x="26" y="16" width="64" height="64" rx="15" fill="var(--sand)" stroke="var(--ink)" stroke-width="3" />
            <rect x="12" y="28" width="64" height="64" rx="15" fill="var(--white)" stroke="var(--ink)" stroke-width="3" />
            <path d="M38 44h12v12h12v12H50v12H38V68H26V56h12z" fill="var(--red)" stroke="var(--ink)" stroke-width="3" stroke-linejoin="round" />
          </svg>
          <div>
            <h3>{t.work.medical.name}</h3>
            <p class="tag">{t.work.medical.tag}</p>
          </div>
        </div>
        <p class="body">{t.work.medical.body}</p>
        <ul class="facts">
          {t.work.medical.stats.map(([n, l], i) => <li class={['paper', 'sand', 'sky', 'paper'][i]}><span class="num">{n}</span>{l}</li>)}
        </ul>
        <ul class="highlights">
          {t.work.medical.highlights.map((x, i) => (
            <li>
              <div class="hl-head"><svg class="hl-icon" viewBox="0 0 64 64" width="36" height="36" aria-hidden="true" set:html={MEDICAL_ICONS[i]} /><span class="caption">{x.h}</span></div>
              <p>{x.p}{'link' in x && x.link && <> <a target="_blank" rel="noopener" class="inline-link" href={x.link.href}>{x.link.text}</a></>}</p>
            </li>
          ))}
        </ul>
        <p class="footnote">{t.work.medical.note}</p>
      </article>
      <article class="panel sky progulki">
        <span class="caption">{t.work.progulki.tag}</span>
        <img class="light-only shot" src="/progulki-top.jpg" alt={`${t.work.progulki.name}: ${ru ? 'главная страница сайта' : 'website home page'}`} width="720" height="778" loading="lazy" decoding="async" />
        <img class="dark-only shot" src="/progulki-top-dark.jpg" alt={`${t.work.progulki.name}: ${ru ? 'главная страница сайта' : 'website home page'}`} width="720" height="778" loading="lazy" decoding="async" />
        <h3><a class="title-link" target="_blank" rel="noopener" href="https://progulka-v-temnote.ru/">{t.work.progulki.name}</a></h3>
        <p>{t.work.progulki.body}</p>
        <p class="links"><a target="_blank" rel="noopener" href="https://progulka-v-temnote.ru/">progulka-v-temnote.ru</a></p>
      </article>
      <div class="work-stack">
        <article class="panel red aviasales">
          <div class="app-head">
            <div class="brand-pair">
              <img class="icon brand-tile" src="/logos/aviasales.svg" alt="" width="56" height="56" style="background: #000" />
              <img class="icon brand-tile" src="/logos/travelpayouts.svg" alt="Travelpayouts" width="56" height="56" style="background: #006dff" />
            </div>
            <div>
              <h3>{t.work.aviasales.name}</h3>
              <p class="tag">{t.work.aviasales.tag}</p>
            </div>
          </div>
          <p>{t.work.aviasales.body}</p>
          <p class="links"><a target="_blank" rel="noopener" href={ru ? 'https://www.travelpayouts.com/ru/offers/aviasales-partnerskaya-programma/' : 'https://www.travelpayouts.com/en/offers/aviasales-affiliate-program/'}>{ru ? 'Партнёрская программа' : 'Partner program'}</a><a target="_blank" rel="noopener" href="https://www.aviasales.ru/">aviasales.ru</a></p>
        </article>
        <article class="panel sand studio">
          <div class="app-head">
            <img src="/logos/skill-surf.webp" alt="" width="72" height="72" class="icon logo-tile" loading="lazy" decoding="async" />
            <div><h3>{t.work.studio.name}</h3><p class="tag">{t.work.studio.tag}</p></div>
          </div>
          <p>{t.work.studio.body}</p>
        </article>
      </div>
    </div>
  </section>

  <section id="products" class="chapter">
    <h2>{t.products.title}</h2>
    <div class="tier products-main">
      {(['cryptoc', 'ssoul'] as const).map((k, i) => {
        const p = t.products.items[k]
        return (
          <article class={`panel ${i ? 'sea' : 'white'} product`}>
            <Shots small items={k === 'cryptoc' ? SHOTS.cryptoc : SHOTS.sportsoul} width={400} height={k === 'cryptoc' ? 870 : 711} label={`${p.name}: ${ru ? 'экраны приложения' : 'app screens'}`} ru={ru} />
            <div class="app-head">
              <img src={`/icons/${k}.png`} alt="" width="72" height="72" class="icon" loading="lazy" />
              <div><h3>{p.name}</h3><p class="tag">{p.tag}</p></div>
            </div>
            <p>{linkParts(p.body).map(({ part, href }) => (href ? <a class="inline-link" target="_blank" rel="noopener" href={href}>{part}</a> : part))}</p>
            <ul class={`facts ${p.stats.length === 3 ? 'three' : 'two'}`}>
              {p.stats.map(([n, l]) => <li class={i ? 'paper' : 'sand'}><span class="num">{n}</span>{l}</li>)}
            </ul>
            {'highlights' in p && p.highlights && (
              <ul class="highlights two-up">
                {p.highlights.map((x, j) => (
                  <li>
                    <div class="hl-head"><svg class="hl-icon" viewBox="0 0 64 64" width="36" height="36" aria-hidden="true" set:html={SSOUL_ICONS[j]} /><span class="caption">{x.h}</span></div>
                    <p>{x.p}</p>
                  </li>
                ))}
              </ul>
            )}
            {k === 'cryptoc' && (
              <p class="links">
                {apps.cryptoc.appStore && <a target="_blank" rel="noopener" href={apps.cryptoc.appStore}><span class="logo-mono" style="--logo: url(/logos/app-store.svg)" aria-hidden="true"></span>App Store</a>}
                <a target="_blank" rel="noopener" href={apps.cryptoc.googlePlay}><span class="logo-mono" style="--logo: url(/logos/google-play.svg)" aria-hidden="true"></span>Google Play</a>
                <a target="_blank" rel="noopener" href={apps.cryptoc.ruStore}><img class="logo-color" src="/logos/rustore.svg" alt="" width="18" height="18" />RuStore</a>
              </p>
            )}
          </article>
        )
      })}
    </div>
    <div class="tier">
      <article class="panel harbour product tmafarm">
        <div class="app-head">
          <svg class="farm-icon" viewBox="0 0 72 72" width="72" height="72" aria-hidden="true">
            <rect x="1.5" y="1.5" width="69" height="69" rx="16" fill="var(--sand)" stroke="var(--ink)" stroke-width="3" />
            <path d="M36 58V34" fill="none" stroke="var(--ink)" stroke-width="3" stroke-linecap="round" /><path d="M36 38c-12 0-18-7-18-17 10 0 18 6 18 17z" fill="var(--sea)" stroke="var(--ink)" stroke-width="3" stroke-linejoin="round" /><path d="M36 34c0-10 6-17 18-17 0 10-6 17-18 17z" fill="var(--sea)" stroke="var(--ink)" stroke-width="3" stroke-linejoin="round" /><path d="M20 58h32" stroke="var(--ink)" stroke-width="3" stroke-linecap="round" />
          </svg>
          <div><h3>{t.products.items.tmafarm.name}</h3><p class="tag">{t.products.items.tmafarm.tag}</p></div>
        </div>
        <p class="body">{t.products.items.tmafarm.body}</p>
        <ul class="facts three">
