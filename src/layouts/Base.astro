---
import '@fontsource/balsamiq-sans/400.css'
import '@fontsource/balsamiq-sans/700.css'
import '@fontsource/pangolin'
import '../styles/global.css'
import stats from '../data/stats.json'
import { dict, links, contests, compact, type Lang } from '../data/content'
import { hirePath } from '../data/hire'
import { LANGS, LANG_INFO, DEFAULT_LANG, langPath, fullLang } from '../data/langs'
import { THEME_INIT } from '../scripts/theme-init.mjs'

// `page` turns the layout into a secondary page: its own address, snippet and structured data.
// Without it the layout renders the home page (a ProfilePage).
interface PageMeta {
  // Address of the English version; the Russian one lives under /ru.
  path: string
  title: string
  description: string
  // Extra JSON-LD nodes; they can point at the person and the site by @id.
  graph?: (ids: { personId: string; websiteId: string; pageUrl: string }) => Record<string, unknown>[]
}
interface Props { lang: Lang; page?: PageMeta }
const { lang, page } = Astro.props
const t = dict[lang]
const info = LANG_INFO[lang]
const site = Astro.site ?? new URL('https://kesha-antonov.com')
const abs = (p: string) => new URL(p, site).href

const homeEn = abs('/')
// The same page in every language, for hreflang.
const versions = LANGS.map((l) => ({ lang: l, href: abs(langPath(l, page?.path ?? '/')) }))
const pageUrl = abs(langPath(lang, page?.path ?? '/'))

// Search snippet texts live in content.ts (meta); {npm} is the live npm total.
const npmTotal = compact(stats.totals.allTime, lang)
const fill = (text: string) => text.replace('{npm}', npmTotal)
const home = { title: t.meta.title, description: fill(t.meta.description), ogAlt: fill(t.meta.ogAlt) }
const seo = page ? { ...home, title: page.title, description: page.description } : home
// The share image exists in English and Russian.
const ogImage = abs(lang === 'ru' ? '/og-ru.png' : '/og.png')
const avatar = 'https://avatars.githubusercontent.com/u/11584712?v=4&s=460'

// Structured data. One Person node shared by both language versions via a stable @id.
const personId = abs('/#person')
const websiteId = abs('/#website')
const libOrder = ['gifted-chat', 'react-native-chat', 'zoom-reanimated', 'background-downloader', 'action-cable', 'cloud-sync'] as const
const P = stats.packages as Record<string, { npm: string; repo: string; allTime?: number; stars?: number }>
const contestText = (place: number, name: string) => `${name}, ${t.contests.place(place)}`
// The ledger says "Maintainer." after Gifted Chat; that role is already in the maintainer field.
const libDesc = (k: string) => t.oss.desc[k].replace(/\s*(Maintainer|Мейнтейнер)\.$/, '')

const person = {
  '@type': 'Person',
  '@id': personId,
  name: 'Kesha Antonov',
  givenName: 'Innokenty',
  familyName: 'Antonov',
  alternateName: ['Innokenty Antonov', 'Кеша Антонов', 'Иннокентий Антонов', 'kesha-antonov'],
  description: home.description,
  jobTitle: t.meta.jobTitle,
  url: homeEn,
  image: avatar,
  email: links.email.replace('mailto:', ''),
  sameAs: [links.github, links.linkedin, links.telegram, links.instagram, links.npm, links.youtube, links.sponsor],
  knowsAbout: ['React Native', 'React Native app development', 'Mobile app development', 'React', 'TypeScript', 'iOS', 'Android', 'Ruby on Rails', 'Product management', 'App Store Optimization', 'Telegram Mini Apps', 'TON'],
  alumniOf: {
    '@type': 'CollegeOrUniversity',
    name: 'Peter the Great St. Petersburg Polytechnic University',
    alternateName: 'СПбПУ Петра Великого',
  },
  makesOffer: {
    '@type': 'Offer',
    itemOffered: {
      '@type': 'Service',
      name: t.meta.service,
      serviceType: 'React Native app development',
      url: abs(hirePath(lang)),
      description: t.contact.body,
    },
  },
  award: contests.map((c) => contestText(c.place, t.contests.items[c.key].name)),
}

const libraries = libOrder.map((k) => {
  const p = P[k]
  return {
    '@type': 'SoftwareSourceCode',
    '@id': `https://github.com/${p.repo}`,
    name: p.npm,
    description: libDesc(k),
    url: `https://www.npmjs.com/package/${p.npm}`,
    codeRepository: `https://github.com/${p.repo}`,
    runtimePlatform: 'React Native',
    maintainer: { '@id': personId },
    // Gifted Chat and background-downloader were started by others; the rest he wrote.
    ...(!['gifted-chat', 'background-downloader'].includes(k) && { author: { '@id': personId } }),
    ...(typeof p.allTime === 'number' && {
      interactionStatistic: {
        '@type': 'InteractionCounter',
        interactionType: 'https://schema.org/DownloadAction',
        userInteractionCount: p.allTime,
      },
    }),
  }
})

const jsonLd = {
  '@context': 'https://schema.org',
  '@graph': [
    {
      '@type': 'WebSite',
      '@id': websiteId,
      url: homeEn,
      name: 'Kesha Antonov',
      alternateName: 'Кеша Антонов',
      inLanguage: LANGS,
      publisher: { '@id': personId },
    },
    ...(page ? (page.graph?.({ personId, websiteId, pageUrl }) ?? []) : [{
      '@type': 'ProfilePage',
      '@id': `${pageUrl}#profilepage`,
      url: pageUrl,
      name: seo.title,
      description: seo.description,
      inLanguage: lang,
      isPartOf: { '@id': websiteId },
      mainEntity: { '@id': personId },
      about: { '@id': personId },
      primaryImageOfPage: { '@type': 'ImageObject', url: ogImage, width: 1200, height: 630 },
      dateModified: stats.updatedAt,
      mentions: libraries.map((l) => ({ '@id': l['@id'] })),
    }]),
    person,
    ...(page ? [] : libraries),
  ],
}
// Keep "<" out of the inline script so no string can close the tag early.
const jsonLdText = JSON.stringify(jsonLd).replace(/</g, '\\u003c')
---
<!doctype html>
<html lang={lang} dir={info.dir}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{seo.title}</title>
    <meta name="description" content={seo.description} />
    <meta name="author" content={t.meta.author} />
    <meta name="robots" content="index, follow, max-image-preview:large, max-snippet:-1" />
    <link rel="canonical" href={pageUrl} />
    {versions.map((v) => <link rel="alternate" hreflang={v.lang} href={v.href} />)}
    <link rel="alternate" hreflang="x-default" href={versions.find((v) => v.lang === DEFAULT_LANG)!.href} />
    <link rel="sitemap" type="application/xml" href={abs('/sitemap.xml')} />
    <link rel="alternate" type="text/plain" title="llms.txt" href={abs('/llms.txt')} />
    {!page && fullLang(lang) === lang && <link rel="alternate" type="text/markdown" title="Markdown" href={abs(lang === 'ru' ? '/ru/index.md' : '/index.md')} />}
    <link rel="author" type="text/plain" href={abs('/humans.txt')} />
    <link rel="icon" href="/favicon.ico" sizes="32x32" />
    <link rel="icon" type="image/png" sizes="192x192" href="/favicon-192.png" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <meta name="theme-color" content="#f6f3e6" media="(prefers-color-scheme: light)" />
    <meta name="theme-color" content="#14161b" media="(prefers-color-scheme: dark)" />
    <!-- Apply the saved theme before first paint; its hash is in the CSP (astro.config.mjs). -->
    <script is:inline set:html={THEME_INIT} />
    <!-- Both schemes: global.css sets the actual one on :root (OS preference or the saved theme). -->
    <meta name="color-scheme" content="light dark" />
    {person.sameAs.map((href) => <link rel="me" href={href} />)}

    <meta property="og:type" content={page ? 'website' : 'profile'} />
    <meta property="og:site_name" content={t.meta.author} />
    <meta property="og:title" content={seo.title} />
    <meta property="og:description" content={seo.description} />
    <meta property="og:url" content={pageUrl} />
    <meta property="og:locale" content={info.og} />
    {LANGS.filter((l) => l !== lang).map((l) => <meta property="og:locale:alternate" content={LANG_INFO[l].og} />)}
    <meta property="og:image" content={ogImage} />
    <meta property="og:image:type" content="image/png" />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content={seo.ogAlt} />
    <meta property="profile:first_name" content="Kesha" />
    <meta property="profile:last_name" content="Antonov" />
    <meta property="profile:username" content="kesha-antonov" />

    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={seo.title} />
    <meta name="twitter:description" content={seo.description} />
    <meta name="twitter:image" content={ogImage} />
    <meta name="twitter:image:alt" content={seo.ogAlt} />

    <script type="application/ld+json" set:html={jsonLdText} />
  </head>
  <body>
    <slot />
  </body>
</html>
